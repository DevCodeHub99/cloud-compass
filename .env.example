# ==============================================================================
# CloudCompass - Environment Configuration Template
# ==============================================================================
# CloudCompass is pre-configured with production-ready zero-configuration defaults
# and works immediately without any .env file.
#
# To customize or override parameters, copy this template to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Telemetry API Base URL (defaults to direct AQI.in cluster or custom reverse proxy)
# VITE_AQI_API_BASE=https://apiserver.aqi.in

# Optional custom telemetry Bearer token (defaults to pre-bundled valid bootstrap token)
# To override or rotate credentials, paste a valid aqi.in JWT Bearer token:
# VITE_AQI_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Production Logging & Observability Threshold: debug | info | warn | error | none
# Defaults to "debug" in development mode and "warn" in production mode
# VITE_LOG_LEVEL=warn
