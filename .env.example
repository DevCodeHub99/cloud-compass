# ==============================================================================
# CloudCompass - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development (never commit .env to git).
# For Vercel deployments, configure these in Project -> Settings -> Env Vars.
# ==============================================================================

# Required: Passphrase protecting the hidden /token rotation portal (/api/token)
ADMIN_SECRET=

# Global Token Persistence (MongoDB Atlas)
# Required on Vercel so /token updates persist across all serverless instances.
# Provide only the raw connection string (mongodb+srv://...), with no extra quotes.
MONGODB_URI=
# MONGODB_DB=cloudcompass

# Optional: Initial fallback AQI.in Bearer JWT & upstream proxy base URL
# AQI_TOKEN=
# AQI_API_BASE=https://apiserver.aqi.in

# Optional: Client log verbosity (debug | info | warn | error | none)
# VITE_LOG_LEVEL=warn
